{
  "name": "obsidian-buddybridge-deep",
  "version": "0.3.0",
  "description": "第三方 Obsidian 插件，通过 ACP (Agent Client Protocol) 桥接 DeepSeek Harness，支持流式响应、思考过程、工具调用与会话管理",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "jest --runInBand --coverage",
    "test:watch": "jest --runInBand --watch",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "deepseek",
    "harness",
    "acp",
    "agent-client-protocol",
    "knowledge-base"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "obsidian": "latest",
    "ts-jest": "^29.0.0",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
